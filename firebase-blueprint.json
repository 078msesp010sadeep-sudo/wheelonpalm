{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and authorization status in Nepal.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["customer", "workshop", "roadside", "admin"] },
        "isEmailVerified": { "type": "boolean" },
        "city": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "fullName", "role"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Registered vehicle profile in user digital garage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "vehicleType": { "type": "string", "enum": ["motorcycle", "scooter", "car", "suv", "ev", "commercial", "other"] },
        "make": { "type": "string", "maxLength": 50 },
        "model": { "type": "string", "maxLength": 50 },
        "manufactureYear": { "type": "number" },
        "registrationNumber": { "type": "string", "maxLength": 50 },
        "chassisNumber": { "type": "string", "maxLength": 50 },
        "engineNumber": { "type": "string", "maxLength": 50 },
        "fuelType": { "type": "string", "enum": ["petrol", "diesel", "electric", "hybrid", "cng", "other"] },
        "currentOdometer": { "type": "number" },
        "odometerUnit": { "type": "string", "enum": ["km", "miles"] },
        "purchaseDate": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "vehicleType", "make", "model", "registrationNumber"]
    },
    "MaintenanceRecord": {
      "title": "MaintenanceRecord",
      "description": "Chronological automotive maintenance or repair record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "vehicleId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "serviceCategory": { "type": "string", "maxLength": 50 },
        "serviceDate": { "type": "string" },
        "odometerReading": { "type": "number" },
        "workshopName": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "labourCostNpr": { "type": "number" },
        "partsCostNpr": { "type": "number" },
        "totalCostNpr": { "type": "number" },
        "nextServiceDate": { "type": "string" },
        "nextServiceOdometer": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "vehicleId", "userId", "serviceCategory", "workshopName", "totalCostNpr"]
    },
    "VehicleDocument": {
      "title": "VehicleDocument",
      "description": "Nepal DOTM Bluebook, Tax token, Insurance, or Emission Green Sticker.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "vehicleId": { "type": "string", "maxLength": 64 },
        "documentType": { "type": "string", "enum": ["bluebook", "vehicle_tax", "insurance", "pollution_test", "driving_licence", "other"] },
        "title": { "type": "string", "maxLength": 100 },
        "referenceNumber": { "type": "string", "maxLength": 100 },
        "issueDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "vehicleId", "documentType", "title", "referenceNumber", "expiryDate"]
    },
    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "Customer appointment reservation with an authorized workshop.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "bookingRef": { "type": "string", "maxLength": 30 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "vehicleId": { "type": "string", "maxLength": 64 },
        "vehicleSummary": { "type": "string", "maxLength": 150 },
        "providerId": { "type": "string", "maxLength": 64 },
        "providerName": { "type": "string", "maxLength": 100 },
        "serviceCategory": { "type": "string", "maxLength": 50 },
        "bookingType": { "type": "string", "enum": ["workshop_visit", "pickup_drop"] },
        "preferredDate": { "type": "string" },
        "preferredTimeSlot": { "type": "string", "maxLength": 50 },
        "problemDescription": { "type": "string", "maxLength": 1000 },
        "estimatedCostNpr": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "scheduled", "in_progress", "completed", "cancelled", "rejected"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "bookingRef", "userId", "vehicleId", "providerId", "status"]
    },
    "EmergencyRequest": {
      "title": "EmergencyRequest",
      "description": "24/7 Roadside breakdown or towing rescue dispatch notice.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "sosRef": { "type": "string", "maxLength": 30 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "vehicleSummary": { "type": "string", "maxLength": 150 },
        "emergencyType": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "locationAddress": { "type": "string", "maxLength": 200 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "status": { "type": "string", "enum": ["requested", "accepted", "provider_assigned", "on_the_way", "resolved", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sosRef", "userId", "contactPhone", "locationAddress", "status"]
    },
    "HimalayanDutyReport": {
      "title": "HimalayanDutyReport",
      "description": "Veterans terrain duty cycle fatigue and thermal stress assessment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "vehicleId": { "type": "string", "maxLength": 64 },
        "routeProfile": { "type": "string", "maxLength": 64 },
        "brakeBoilingRiskPercent": { "type": "number" },
        "clutchHeatStressPercent": { "type": "number" },
        "oilOxidationFactor": { "type": "number" },
        "suspensionFatiguePercent": { "type": "number" },
        "overallHealthIndex": { "type": "number" },
        "recommendations": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "vehicleId", "overallHealthIndex"]
    },
    "ProvenanceCertificate": {
      "title": "ProvenanceCertificate",
      "description": "Nepal vehicle resale provenance valuation and ownership authenticity certificate.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "vehicleId": { "type": "string", "maxLength": 64 },
        "provenanceScore": { "type": "number" },
        "estimatedMarketValueNpr": { "type": "number" },
        "verifiedHistoryBonusNpr": { "type": "number" },
        "issuedAt": { "type": "string" }
      },
      "required": ["id", "vehicleId", "provenanceScore", "estimatedMarketValueNpr"]
    },
    "VehicleMarketplaceListing": {
      "title": "VehicleMarketplaceListing",
      "description": "Peer-to-peer bike and vehicle sale or rental listing by owner with photos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 30 },
        "listingType": { "type": "string", "enum": ["sale", "rental", "both"] },
        "title": { "type": "string", "maxLength": 120 },
        "vehicleType": { "type": "string", "enum": ["motorcycle", "scooter", "car", "suv", "ev", "other"] },
        "make": { "type": "string", "maxLength": 50 },
        "model": { "type": "string", "maxLength": 50 },
        "manufactureYear": { "type": "number" },
        "odometerKm": { "type": "number" },
        "registrationNumber": { "type": "string", "maxLength": 50 },
        "salePriceNpr": { "type": "number" },
        "isPriceNegotiable": { "type": "boolean" },
        "rentalRateDailyNpr": { "type": "number" },
        "rentalRateWeeklyNpr": { "type": "number" },
        "rentalSecurityDepositNpr": { "type": "number" },
        "includesHelmets": { "type": "boolean" },
        "location": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1500 },
        "images": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "rented", "inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "listingType", "title", "vehicleType", "make", "model", "location"]
    },
    "PartsOrder": {
      "title": "PartsOrder",
      "description": "Customer e-commerce shopping cart order for automotive spare parts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "orderRef": { "type": "string", "maxLength": 32 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "deliveryAddress": { "type": "string", "maxLength": 250 },
        "city": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "enum": ["cod", "esewa", "khalti"] },
        "itemsJson": { "type": "string" },
        "subtotalNpr": { "type": "number" },
        "deliveryFeeNpr": { "type": "number" },
        "totalAmountNpr": { "type": "number" },
        "status": { "type": "string", "enum": ["placed", "confirmed", "dispatched", "delivered", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderRef", "userId", "customerName", "customerPhone", "totalAmountNpr", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles with role restrictions and contact details."
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Stores customer vehicles with owner access rules."
    },
    "/vehicles/{vehicleId}/inspections/{inspectionId}": {
      "schema": "HimalayanDutyReport",
      "description": "Stores duty-cycle terrain wear simulations."
    },
    "/provenanceEvaluations/{evalId}": {
      "schema": "ProvenanceCertificate",
      "description": "Stores official resale provenance valuations."
    },
    "/marketplaceListings/{listingId}": {
      "schema": "VehicleMarketplaceListing",
      "description": "Stores user-submitted vehicles for sale and rent with photos."
    },
    "/partsOrders/{orderId}": {
      "schema": "PartsOrder",
      "description": "Stores shopping orders for spare parts and lubricants."
    },
    "/maintenanceRecords/{recordId}": {
      "schema": "MaintenanceRecord",
      "description": "Stores service and repair logs."
    },
    "/vehicleDocuments/{documentId}": {
      "schema": "VehicleDocument",
      "description": "Stores Bluebook, Tax, and Insurance document expiration records."
    },
    "/bookings/{bookingId}": {
      "schema": "ServiceBooking",
      "description": "Stores workshop bay service appointments."
    },
    "/emergencyRequests/{requestId}": {
      "schema": "EmergencyRequest",
      "description": "Stores 24/7 roadside assistance calls."
    }
  }
}
